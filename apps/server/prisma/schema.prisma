// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
    userID       Int         @id @default(autoincrement())
    email        String      @unique
    firstName    String
    lastName     String
    password     String
    role         String
    pharmacyID   Int?
    pharmacy     Pharmacies?  @relation(fields: [pharmacyID], references: [pharmacyID])
}

model Pharmacies {
    pharmacyID     Int     @id @default(autoincrement())
    name           String
    address        String
    city           String
    state          String
    zip            Int
    users          User[]
    drones         Drones[]
    orders         Orders[]
}

model Drones {
    droneID        Int         @id @default(autoincrement())
    pharmacyID     Int
    pharmacy       Pharmacies  @relation(fields: [pharmacyID], references: [pharmacyID])
    currentStatus  String      @default("IDLE")
    batteryLevel   Int
    orders         Orders[]
    locations      DroneLocation[]
}

model Orders {
    orderID            Int         @id @default(autoincrement())
    pharmacyID         Int
    pharmacy           Pharmacies  @relation(fields: [pharmacyID], references: [pharmacyID])
    droneID            Int?
    drone              Drones?     @relation(fields: [droneID], references: [droneID])
    customerFirstName  String
    customerLastName   String
    address            String
    city               String
    state              String
    zip                Int
    status             String      @default("PENDING")
    medicationName     String
}

model DroneLocation {
    locationID   Int       @id @default(autoincrement())
    droneID      Int
    drone        Drones    @relation(fields: [droneID], references: [droneID], onDelete: Cascade)
    latitude     Float
    longitude    Float
    reportedAt   DateTime  @default(now())
}
